{
  "manifest_version": 3,
  "name": "One-Click Job Autofill",
  "version": "1.0.0",
  "description": "Fills job application forms locally from your saved profile and CV. Never submits for you.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "webNavigation"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": { "default_popup": "popup.html", "default_title": "Autofill this application" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
